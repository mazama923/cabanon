# Copy to /etc/cabanon/cabanon.env and set mode 0600.
CABANON_ENV=production
CABANON_SECRET_KEY_BASE=replace-with-a-random-64-hex-character-secret
CABANON_DATABASE_URL=postgresql://cabanon_app:replace-with-url-encoded-password@127.0.0.1:5432/cabanon?sslmode=disable
CABANON_BIND_ADDRESS=replace-with-private-cabanon-lxc-address
CABANON_PORT=8080
CABANON_ALLOWED_ORIGIN=https://cabanon.example.com
